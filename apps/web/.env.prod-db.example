# Production database connection for running Drizzle against prod from a trusted
# operator machine over Tailscale. Copy to apps/web/.env.prod-db (gitignored) and
# fill in.
#
# Usage (with Tailscale connected):
#   make auth-db action=migrate env=prod   # apply versioned migrations
#   make auth-db action=studio  env=prod   # browse the prod database
#
# Use the production database host's Tailscale name or 100.x.y.z IP.
# NEVER run db:push against production — use versioned migrations only.
#
# NOTE: deliberately NOT named .env.production — Next.js auto-loads that file
# during `next build`, which would point local production builds at the prod DB.

DATABASE_URL=postgresql://user:password@<tailscale-host>:5432/betterauth
