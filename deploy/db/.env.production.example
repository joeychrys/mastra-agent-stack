# Production database connection for running migrations from a trusted operator
# machine over Tailscale. Copy to deploy/db/.env.production (gitignored) and fill in.
#
# Usage (with Tailscale connected):
#   make db-migrate-prod   # apply versioned migrations
#   make db-studio-prod    # browse the prod database
#
# Use the production database host's Tailscale name or 100.x.y.z IP.
# NEVER run db:push against production — use versioned migrations only.

DATABASE_URL=postgresql://user:password@<tailscale-host>:5432/betterauth
